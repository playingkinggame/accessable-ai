# ---------- App / auth ----------
APP_PASSWORD=change-me
AGENT_KEY=change-me-long-random
SECRET_KEY=change-me-too
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_BASE_URL=http://localhost:8000
DATA_DIR=./data

# ---------- LLM chain ----------
LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT=25
REASONING_CHAT=medium
REASONING_VOICE=low

# ---------- RAG ----------
EMBEDDING_MODEL=intfloat/multilingual-e5-large
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_COLLECTION=folio_e5
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=60
TOP_K=3
#CHUNK_SIZE=700
#CHUNK_OVERLAP=100
#TOP_K=5
MIN_SCORE=0.78

# ---------- LiveKit / voice ----------
VOICE_ENABLED=true
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STT_MODEL=whisper-large-v3
# Leave empty: Whisper detects Tamil/English per utterance, so replies follow the person's speech.
# Set to ta or en only if you want to pin it.
STT_LANGUAGE=
# TTS: inference (LiveKit Inference, default) | auto | google | edge
TTS_PROVIDER=inference
TTS_MODEL=cartesia/sonic-3
# Cartesia voice IDs from the voice library; leave blank for the model default.
TTS_VOICE_TA=
TTS_VOICE_EN=
# edge-tts is only the fallback when Inference fails.
EDGE_TTS_VOICE=ta-IN-PallaviNeural
EDGE_TTS_VOICE_EN=en-IN-NeerjaNeural

# ---------- Eval / samples ----------
EVAL_QUESTIONS=eval/questions.json
NOTO_TAMIL_TTF=
